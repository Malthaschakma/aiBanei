# Copy to .env.local and fill in. Never commit .env.local.
#
# Phase 1 runs entirely without these. When they are absent the app serves the
# clearly-marked development fixtures in lib/dev-data and the auth pages stay
# inert. Setting them switches lib/opportunities/queries.ts over to Supabase.

# --- Supabase -----------------------------------------------------------
# Project Settings -> API. The anon key is safe to expose to the browser; it is
# only useful in combination with the Row Level Security policies in
# supabase/migrations/0002_rls.sql.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Bypasses Row Level Security entirely, so it must never be
# prefixed with NEXT_PUBLIC_ and must never be imported into a client module.
# Not read anywhere in Phase 1.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ---------------------------------------------------------------
# Absolute origin, used for canonical URLs and Open Graph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Analytics (Phase 2) ------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Email (Phase 2) ----------------------------------------------------
RESEND_API_KEY=
